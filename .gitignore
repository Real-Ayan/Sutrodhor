# Sutrodhor .gitignore

# --- OS ---
.DS_Store
Thumbs.db
*~

# --- Editors / IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- Cursor (local) ---
.cursor/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- Rust / Cargo ---
target/
**/*.rs.bk
Cargo.lock.bak

# --- Node ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tauri / Vite ---
apps/desktop/src-tauri/target/
apps/desktop/dist/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.uv/

# --- uv / packaging ---
apps/ai-server/.venv/

# --- Logs / temp ---
*.log
tmp/
temp/
.cache/

# --- Project runtime (user data — never commit) ---
**/.sutrodhor/index.sqlite
**/.sutrodhor/*.sqlite-journal
